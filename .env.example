# Copy to .env.development.local (or .env.development) and adjust. Never commit real values.

# The kordi API (the Spring server). Locally: run the server repo on :8080.
# Pointing a development build at production (https://api.kordi.online) reads and writes
# real data; the app warns in the console when it does.
NEXT_PUBLIC_API_URL=http://localhost:8080

# The piano world's WebSocket. Optional: derived from NEXT_PUBLIC_API_URL (ws://…/ws/world).
# NEXT_PUBLIC_WORLD_SOCKET_URL=ws://localhost:8080/ws/world

# Where the server repo is checked out (default ../server). The contract tests compare the
# client with it (chord validator fixtures, the world contract) and skip when it's absent;
# scripts/gen-chord-fixtures.mjs writes the server's fixture there.
# KORDI_SERVER_DIR=../server
